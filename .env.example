# carolus-ops environment template — copy to .env and fill from Doppler.
# Placeholders only here; real values NEVER enter git.

# QuickBooks Online app client id (Intuit developer portal)
QBO_CLIENT_ID=your-qbo-client-id
# QuickBooks Online app client secret (pairs with the client id for OAuth)
QBO_CLIENT_SECRET=your-qbo-client-secret
# OAuth2 redirect URI exactly as registered on the QBO app
QBO_REDIRECT_URI=http://localhost:8765/qbo/callback
# QBO API target: sandbox or production
QBO_ENVIRONMENT=sandbox
# Canonical Postgres connection string
DATABASE_URL=postgresql://carolus:password@localhost:5432/carolus
# Cloudflare R2 account id (document/object storage)
R2_ACCOUNT_ID=your-r2-account-id
# R2 API token access key id
R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2 API token secret access key
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Resend API key for outbound email
RESEND_API_KEY=re_your-resend-api-key
